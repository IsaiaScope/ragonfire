# --- macOS AppleDouble (Crucial-4T is exFAT) ---
._*
.DS_Store
.Spotlight-V100
.Trashes
$RECYCLE.BIN/

# --- Big binary data (do NOT push) ---

# Ollama runtime — models + state. ~/.ollama symlinks here when models live in repo.
# id_ed25519 is the Ollama private signing key — NEVER commit.
ollama/models/
ollama/blobs/
ollama/manifests/
ollama/cache/
ollama/history
ollama/id_ed25519
ollama/id_ed25519.pub
ollama/.fseventsd/

# MinerU models — first ingest downloads ~5 GB via HF Hub + ModelScope
mineru/models/
mineru/cache/
mineru/huggingface/
mineru/modelscope/
mineru/.cache/

# RAG-Anything runtime
rag-anything/.venv/
rag-anything/storage/
rag-anything/output/
rag-anything/input/
rag-anything/logs/
rag-anything/.env

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs / pid / tmp ---
*.log
*.pid
*.tmp
*.bak

# --- Node (if ever added) ---
node_modules/
.pnpm-store/
.iso/
