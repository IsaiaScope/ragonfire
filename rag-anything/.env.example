# LightRAG server config (read by lightrag-server)
# Copy to .env and edit if needed

# Storage
WORKING_DIR=/Volumes/Crucial-4T/rag-anything/storage
INPUT_DIR=/Volumes/Crucial-4T/rag-anything/input

# Server
HOST=0.0.0.0
PORT=9621
WORKERS=1

# LLM (Ollama qwen2.5-vl 7B)
LLM_BINDING=ollama
LLM_BINDING_HOST=http://localhost:11434
LLM_MODEL=qwen2.5vl:7b
LLM_BINDING_API_KEY=ollama
MAX_TOKENS=32768
TIMEOUT=300

# Embeddings (Ollama bge-m3, 1024-dim)
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_NUM=10

# Query
TOP_K=40
COSINE_THRESHOLD=0.2

# Ingest
MAX_PARALLEL_INSERT=2
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

# Auth (disable for local)
AUTH_ACCOUNTS=
TOKEN_SECRET=
WHITELIST_PATHS=*

# Logging
VERBOSE=false
LOG_DIR=/Users/isaia/rag-anything/logs

# MinerU device for RAG-Anything ingest (mps for Apple Silicon)
MINERU_DEVICE=mps
MINERU_BACKEND=pipeline

# RAG-Anything parser
PARSER=mineru
PARSE_METHOD=auto
OUTPUT_DIR=/Volumes/Crucial-4T/rag-anything/output
