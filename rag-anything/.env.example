# --- Postgres (LightRAG storage backend) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_EXTERNAL=localhost
POSTGRES_PORT_EXTERNAL=5433
POSTGRES_USER=ragonfire
POSTGRES_PASSWORD=ragonfire
POSTGRES_DATABASE=ragonfire
POSTGRES_WORKSPACE=default
WORKSPACE=default

LIGHTRAG_KV_STORAGE=PGKVStorage
LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
LIGHTRAG_GRAPH_STORAGE=PGGraphStorage
LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

# --- pgvector HNSW ---
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=40

# --- Drive-resident bulk data (ExFAT-safe; bootstrap stamps real paths) ---
INPUT_DIR=/Volumes/Crucial-4T/repo/ragonfire/data/input
OUTPUT_DIR=/Volumes/Crucial-4T/repo/ragonfire/data/output
WORKING_DIR=/Volumes/Crucial-4T/repo/ragonfire/data/working
BACKUPS_DIR=/Volumes/Crucial-4T/repo/ragonfire/data/backups
# Ollama weights on INTERNAL SSD: ollama reloads/swaps GGUF between qwen2.5
# (extract) and bge-m3 (embed) during ingest; from exFAT each reload cost
# seconds and dominated runtime. Internal load ~0.06s.
OLLAMA_MODELS=/Users/isaia/.ollama/models
HF_HOME=/Volumes/Crucial-4T/repo/ragonfire/data/hf

# --- Loopback image ---
PGDATA_IMG=/Volumes/Crucial-4T/repo/ragonfire/data/pgdata.ext4.img
PGDATA_IMG_CAP=50G

# --- MinerU device probe ---
MINERU_DEVICE=auto
MINERU_BACKEND=pipeline
# auto routes PDFs three ways: no text layer -> MinerU OCR (scanned); text +
# large figures/charts (>=15% page) -> hybrid (MinerU vision + recover dropped
# text); text + only small/decorative images -> pymupdf fast path (no OCR).
# Force with mineru / pymupdf / hybrid.
PARSER=auto
PARSE_METHOD=auto

# --- LightRAG server ---
LIGHTRAG_PORT_EXTERNAL=9622
LIGHTRAG_PORT_INTERNAL=9621
HOST=0.0.0.0
PORT=9621
WORKERS=1

# --- LLM (Ollama, host-native) ---
LLM_BINDING=ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen2.5vl:7b
LLM_BINDING_API_KEY=ollama
MAX_TOKENS=32768
# Per-request LLM timeout. A single rich extraction call on qwen2.5:7b at
# ~19 tok/s (M4 GPU) can run ~4-5 min; 300s timed out mid-extract. 900s gives
# headroom without masking a genuinely stuck call.
TIMEOUT=900

# --- Embeddings ---
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_NUM=10

# --- Retrieval ---
TOP_K=40
COSINE_THRESHOLD=0.2
ENABLE_RERANK=false
MIN_RERANK_SCORE=0.0

# --- Chunking ---
MAX_PARALLEL_INSERT=2
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=100

# --- Auth (disabled for local) ---
AUTH_ACCOUNTS=
TOKEN_SECRET=
WHITELIST_PATHS=*

# --- Logging ---
VERBOSE=false
LOG_DIR=/var/log/lightrag
HOST_LOGS_DIR=/Volumes/Crucial-4T/repo/ragonfire/data/logs

# Repo path (set by bootstrap so scripts find infra/* from anywhere)
RAGONFIRE_REPO_DIR=/Volumes/Crucial-4T/repo/ragonfire
